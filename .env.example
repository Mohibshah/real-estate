# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=leads_user
DB_PASSWORD=change-me
DB_NAME=real_estate

# ---------- Notifications ----------
# Provider: "resend" (HTTP email API), "smtp" (any SMTP server: SendGrid, Mailgun, SES, Gmail...), or "none"
NOTIFY_PROVIDER=resend
NOTIFY_TO=agent@example.com
NOTIFY_FROM="Website Leads <leads@example.com>"
# Send an automatic confirmation email to the lead as well (true/false)
NOTIFY_SEND_AUTOREPLY=true

# Resend (https://resend.com) — used when NOTIFY_PROVIDER=resend
RESEND_API_KEY=

# SMTP — used when NOTIFY_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional: POST every new lead as JSON to a webhook (CRM, Zapier, Slack, Make...)
LEAD_WEBHOOK_URL=

# ---------- Spam protection ----------
# Max submissions per IP per window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000
# Submissions faster than this (ms after the form rendered) are treated as bots
MIN_FILL_TIME_MS=3000
